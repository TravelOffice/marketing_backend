{
  "Comment": "A Hello World example demonstrating various state types of the Amazon States Language",
  "StartAt": "Query Admins Information",
  "States": {
    "Auto assign notification service - Handle error": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "Payload.$": "$",
        "FunctionName.$": "$.env.notifyChatLambdaFn"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Next": "No"
    },
    "Query Admins Information": {
      "Type": "Task",
      "Next": "Check admins information",
      "Parameters": {
        "TableName.$": "$.dynamoTravelTable",
        "KeyConditionExpression": "#pk = :pk AND begins_with(#sk, :sk)",
        "ExpressionAttributeNames": {
          "#pk": "pk",
          "#sk": "sk",
          "#roles": "roleStr"
        },
        "ExpressionAttributeValues": {
          ":pk": {
            "S.$": "$.tenant"
          },
          ":sk": {
            "S": "EMPLOYEE"
          },
          ":role": {
            "S": "#ADMIN#"
          }
        },
        "FilterExpression": "contains(#roles, :role)"
      },
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:query",
      "ResultPath": "$.admins",
      "InputPath": "$.env"
    },
    "Check admins information": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.admins.Count",
          "NumericEquals": 0,
          "Next": "Generate no admins error code"
        }
      ],
      "Default": "Get emails of all admins"
    },
    "Generate no admins error code": {
      "Type": "Pass",
      "Next": "Auto assign notification service - Handle error",
      "Result": {
        "code": "AUTO_ASSIGN_NO_ADMINS"
      },
      "ResultPath": "$.assignment"
    },
    "Get emails of all admins": {
      "Type": "Map",
      "Next": "Query Available Sales",
      "Iterator": {
        "StartAt": "Get email of admin",
        "States": {
          "Get email of admin": {
            "Type": "Pass",
            "End": true,
            "OutputPath": "$.email.S"
          }
        }
      },
      "ItemsPath": "$.Items",
      "ResultPath": "$.admins.emails",
      "InputPath": "$.admins"
    },
    "Query Available Sales": {
      "Type": "Task",
      "Next": "Check available sales",
      "Parameters": {
        "TableName.$": "$.dynamoTravelTable",
        "IndexName": "Index1",
        "KeyConditionExpression": "#pk = :pk AND #lsi = :lsi",
        "ExpressionAttributeNames": {
          "#pk": "pk",
          "#lsi": "lsi1"
        },
        "ExpressionAttributeValues": {
          ":pk": {
            "S.$": "$.tenant"
          },
          ":lsi": {
            "S": "EMPLOYEE#ENABLED"
          },
          ":wct": {
            "Bool": false
          },
          ":role": {
            "S": "#SALE#"
          }
        },
        "FilterExpression": "wct = :wct and contains(roleStr, :role)"
      },
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:query",
      "InputPath": "$.env",
      "ResultPath": "$.sales"
    },
    "Check available sales": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.sales.Count",
          "NumericEquals": 0,
          "Next": "Generate no available sale error code"
        }
      ],
      "Default": "Auto assign service"
    },
    "Generate no available sale error code": {
      "Type": "Pass",
      "Next": "Auto assign notification service - Handle error",
      "Result": {
        "code": "AUTO_ASSIGN_NO_AVAILABLE_SALE"
      },
      "ResultPath": "$.assignment"
    },
    "Auto assign notification service - Waiting sale reply": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName.$": "$.env.notifyChatLambdaFn",
        "Payload": {
          "conversation.$": "$.conversation",
          "admins.$": "$.admins",
          "assignment.$": "$.assignment",
          "taskToken.$": "$$.Task.Token"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Next": "Delete task token after sale response to new chat",
      "TimeoutSeconds": 300,
      "Catch": [
        {
          "ErrorEquals": [
            "States.Timeout"
          ],
          "Next": "Generate sale not response error code",
          "ResultPath": "$.error",
          "Comment": "Sale must reply to new chat in 5 minutes"
        }
      ],
      "ResultPath": null
    },
    "Generate sale not response error code": {
      "Type": "Pass",
      "Next": "Delete task token when sale not response",
      "Parameters": {
        "env.$": "$.env",
        "conversation.$": "$.conversation",
        "assignment": {
          "code": "AUTO_ASSIGN_NOT_RESPONSE_NEW_CHAT",
          "assignedSale.$": "$.assignment.assignedSale"
        }
      }
    },
    "Delete task token when sale not response": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:deleteItem",
      "Parameters": {
        "TableName.$": "$.dynamoChatTable",
        "Key": {
          "pk": {
            "S.$": "$.conversationTaskToken.pk"
          },
          "sk": {
            "S.$": "$.conversationTaskToken.sk"
          }
        }
      },
      "Next": "Update waiting for chat state after sale not response",
      "InputPath": "$.env",
      "ResultPath": null
    },
    "Update waiting for chat state after sale not response": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName.$": "$.env.dynamoTravelTable",
        "Key": {
          "pk": {
            "S.$": "$.assignment.assignedSale.pk"
          },
          "sk": {
            "S.$": "$.assignment.assignedSale.sk"
          }
        },
        "UpdateExpression": "SET wct = :wct",
        "ExpressionAttributeValues": {
          ":wct": {
            "BOOL": false
          }
        },
        "ReturnValues": "UPDATED_NEW"
      },
      "Next": "Auto assign notification service - Handle error",
      "ResultPath": null
    },
    "Delete task token after sale response to new chat": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:deleteItem",
      "Parameters": {
        "TableName.$": "$.dynamoChatTable",
        "Key": {
          "pk": {
            "S.$": "$.conversationTaskToken.pk"
          },
          "sk": {
            "S.$": "$.conversationTaskToken.sk"
          }
        }
      },
      "Next": "Update waiting for chat state after sale response",
      "InputPath": "$.env",
      "ResultPath": null
    },
    "Update waiting for chat state after sale response": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName.$": "$.env.dynamoTravelTable",
        "Key": {
          "pk": {
            "S.$": "$.assignment.assignedSale.pk"
          },
          "sk": {
            "S.$": "$.assignment.assignedSale.sk"
          }
        },
        "UpdateExpression": "SET wct = :wct",
        "ExpressionAttributeValues": {
          ":wct": {
            "BOOL": false
          }
        },
        "ReturnValues": "UPDATED_NEW"
      },
      "Next": "Success",
      "ResultPath": null
    },
    "No": {
      "Type": "Fail",
      "Cause": "Failed auto assign"
    },
    "Auto assign service": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName.$": "$.env.assignChatLambdaFn",
        "Payload": {
          "conversation.$": "$.conversation",
          "sales.$": "$.sales.Items"
        }
      },
      "Next": "Generate assigning sale successfully code",
      "ResultPath": "$.assignment",
      "TimeoutSeconds": 3,
      "ResultSelector": {
        "assignedSale.$": "$.Payload.assignedSale"
      }
    },
    "Generate assigning sale successfully code": {
      "Type": "Pass",
      "Next": "Auto assign notification service - Waiting sale reply",
      "Parameters": {
        "env.$": "$.env",
        "admins.$": "$.admins",
        "conversation.$": "$.conversation",
        "assignment": {
          "code": "AUTO_ASSIGN_NEW_CHAT_SUCCESSFULLY",
          "assignedSale.$": "$.assignment.assignedSale"
        }
      }
    },
    "Success": {
      "Type": "Succeed",
      "Comment": "Assign chat to sale successfully"
    }
  }
}
