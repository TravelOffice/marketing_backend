#set( $indentity = [] )
#set( $tenant = "" )
#set( $username = "" )
#set( $roles = [] )
#set( $permissions = [] )

## Get tenant user information from identifying information
#if( $context.identity.resolverContext )
    ## Lambda authorizer
    #set( $tenant = $context.identity.resolverContext.tenant )
    #set( $username = $context.identity.resolverContext.username )
    #set( $roles = $util.parseJson($context.identity.resolverContext.roles) )
    #set( $permissions = $util.parseJson($context.identity.resolverContext.permissions) )
#else
    $util.error('OnReceivedMessage: Missing identifying information!')
#end

#*
 * Setting up subscription filtering.
 * Each web client that represent individual user can only received the conversation which was assigned before
 * - Tenant root account can receive all the conversation related to tenant pages
 * - Employee user can only received assigned conversations
 * The subscription filter is combined by two conditions with OR operator as below
 *#
#if( $permissions.contains("view_all_conversations"))
    ## Root or admin can get all the messages related to tenant
    $extensions.setSubscriptionFilter({
        "filterGroup": [{
            "filters" : [
                {
                    "fieldName" : "tenant",
                    "operator" : "eq",
                    "value" : $tenant
                }
            ]

        }]
    })
#else
    ## Message information should matches both tenant and username
    $extensions.setSubscriptionFilter({
        "filterGroup": [{
            "filters" : [
                {
                    "fieldName" : "tenant",
                    "operator" : "eq",
                    "value" : $tenant
                },
                {
                    "fieldName" : "username",
                    "operator" : "eq",
                    "value" : $username
                }
            ]

        }]
    })
#end

$utils.toJson($context.result)
