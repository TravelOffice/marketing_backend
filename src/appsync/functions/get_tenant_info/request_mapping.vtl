#*
 * Get tenant user information from identifying information
 * The format of tenant username as following:
 *  - Tenant root user: username
 *  - Tenant employee id: tenantName#username
 * EX: Tenant root user: pys
 *      Tenant employee user: pys#binhnv
 *      Invalid username: pys#binhnv#xxxx
 * To get the tenant user information, there are steps need to do:
 * - Step 1: Check the identifying information
 * - Step 2: Get the username of the authenticated user
 * - Step 3: Check whether the username follow rule or not
 * - Step 4: Check whether the user is a root tenant user or not
 * - Step 5: Append tenant information to context arguments
 *#

#set( $indentity = [] )
#set( $tenant = "" )
#set( $username = "" )
#set( $USERNAME_DELIMITER = "#" )

#if( $context.identity )
    #set( $indentity = $context.identity.username.split("[$USERNAME_DELIMITER]") )
    #if( $indentity.size() < 1 || $indentity.size() > 2 )
      $util.error('GetTenantInfo: Invalid authenticated username!')
    #else
      #set( $tenant = $indentity.get(0) )
      #set( $username_index = $identity.size() - 1 )
      #set( $username = $indentity.get( $username_index ) )
    #end
#else
  $util.error('GetTenantInfo: Missing identifying information!')
#end

## Append tenant information to stash map to pass tenant, username through pipeline resolver
## Then, Lambda resolver function can use these values later
$util.qr($context.stash.put("tenant", $tenant))
$util.qr($context.stash.put("username", $username))

{}
